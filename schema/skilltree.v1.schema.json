{
  "title": "IRL Skilltree v1",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "number",
      "const": 1
    },
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "description": {
      "type": "string",
      "maxLength": 10000
    },
    "authors": {
      "type": "array",
      "items": {
        "type": "string",
        "maxLength": 200
      }
    },
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "treeId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "note": {
            "type": "string",
            "maxLength": 10000
          }
        },
        "required": [
          "treeId"
        ],
        "additionalProperties": false
      }
    },
    "nodes": {
      "maxItems": 5000,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "kind": {
            "type": "string",
            "enum": [
              "group",
              "skill"
            ]
          },
          "parentId": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1,
                "maxLength": 200
              },
              {
                "type": "null"
              }
            ]
          },
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "summary": {
            "type": "string",
            "maxLength": 10000
          },
          "unlocks": {
            "type": "string",
            "maxLength": 10000
          },
          "origin": {
            "type": "object",
            "properties": {
              "treeId": {
                "type": "string",
                "minLength": 1,
                "maxLength": 200
              },
              "nodeId": {
                "type": "string",
                "minLength": 1,
                "maxLength": 200
              },
              "treeTitle": {
                "type": "string",
                "minLength": 1,
                "maxLength": 200
              }
            },
            "required": [
              "treeId",
              "nodeId"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "id",
          "kind",
          "parentId",
          "title"
        ],
        "additionalProperties": false
      }
    },
    "relations": {
      "maxItems": 20000,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "type": {
            "type": "string",
            "enum": [
              "prerequisite",
              "related"
            ]
          },
          "from": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "to": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "note": {
            "type": "string",
            "maxLength": 10000
          },
          "external": {
            "type": "object",
            "properties": {
              "treeId": {
                "type": "string",
                "minLength": 1,
                "maxLength": 200
              },
              "title": {
                "type": "string",
                "minLength": 1,
                "maxLength": 200
              },
              "path": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 200
                }
              }
            },
            "required": [
              "treeId"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "id",
          "type",
          "from",
          "to"
        ],
        "additionalProperties": false
      }
    },
    "achievements": {
      "maxItems": 5000,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "description": {
            "type": "string",
            "maxLength": 10000
          },
          "skillIds": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 200
            }
          },
          "condition": {
            "oneOf": [
              {
                "type": "object",
                "properties": {
                  "kind": {
                    "type": "string",
                    "const": "text"
                  },
                  "text": {
                    "type": "string",
                    "maxLength": 10000
                  }
                },
                "required": [
                  "kind",
                  "text"
                ],
                "additionalProperties": false
              }
            ]
          }
        },
        "required": [
          "id",
          "title",
          "skillIds",
          "condition"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "schemaVersion",
    "id",
    "title",
    "nodes",
    "relations",
    "achievements"
  ],
  "additionalProperties": false
}
